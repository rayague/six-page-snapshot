# Connexion Elasticsearch du dashboard (lue uniquement côté serveur).
# Copiez ce fichier en .env et remplissez vos valeurs. Le .env n'est jamais commité.

# URL du cluster : local (Docker) ou Elastic Cloud
ES_URL=http://localhost:9200

# Authentification : renseignez SOIT une clé d'API...
ES_API_KEY=
# ...SOIT un utilisateur / mot de passe
ES_USERNAME=
ES_PASSWORD=

# Index des étudiants (documents { nom, pays, date_inscription })
ES_INDEX=utilisateurs
